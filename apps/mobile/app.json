{
  "expo": {
    "name": "Barakah Stories",
    "slug": "barakah-stories",
    "version": "1.0.0",
    "scheme": "barakah",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1f1c",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1f1c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.barakah.stories",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to calculate prayer times and the Qibla direction on this device, and to look up your city name. It is never sent to us.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.barakah.stories",
      "adaptiveIcon": {
        "backgroundColor": "#0b2e2a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false,
      "versionCode": 4
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to calculate prayer times and the Qibla direction on this device, and to look up your city name. It is never sent to us."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#0b2e2a",
          "defaultChannel": "daily-reminder"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
