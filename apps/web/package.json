{
  "name": "@barakah/web",
  "private": true,
  "version": "0.1.0",
  "description": "Create and share Islamic WhatsApp story posts: Friday, morning duaa, Ramadan, Eid and more.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
