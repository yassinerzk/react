    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "adhan": "^4.4.6",
    "html-to-image": "^1.11.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15",
    "@barakah/core": "*"
  },
  "devDependencies": {
