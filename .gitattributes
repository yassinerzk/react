# Normalise line endings: LF in the repository and on checkout, so Prettier's
# expectations hold on Windows as well as on the Linux CI runner. Without this,
# core.autocrlf=true checks out CRLF and `npm run format:check` fails on every file.
* text=auto eol=lf

# Never transform binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.svg   text eol=lf
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.jks   binary
*.keystore binary
